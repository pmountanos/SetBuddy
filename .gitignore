# macOS
.DS_Store

# Build products / archives / exports — build/ExportOptions-*.plist are hand-authored signing
# config (export method — the team ID is added at build time), not generated output, so they're kept and tracked.
build/*.xcarchive/
*.ipa
DistributionSummary.plist
Packaging.log
ExportOptions.plist

# VS Code workspace settings (machine-specific toolchain paths)
.vscode/

# Gradle / Android
.gradle/
local.properties
*.hprof
captures/
.cxx/

# Release signing — never commit the keystore or its passwords. Back the .jks up somewhere safe
# (password manager attachment, external drive) outside this repo; losing it means future release
# builds can no longer be signed to match earlier ones.
keystore/
keystore.properties

# React Native Android release APKs (scripts/build_mobile_android.sh)
build/apk-mobile/

# Last builds of the retired native apps, kept locally as a fallback
build/native-final/

# Local signing settings (Apple team ID) — see signing.local.env.example
signing.local.env
